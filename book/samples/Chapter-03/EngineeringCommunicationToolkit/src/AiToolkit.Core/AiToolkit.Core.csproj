<Project Sdk="Microsoft.NET.Sdk">
  <!-- book/samples/Chapter-03/EngineeringCommunicationToolkit/src/AiToolkit.Core/AiToolkit.Core.csproj -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!-- Core has no NuGet dependencies — pure calculation + prompt rendering. -->
  <!-- TokenEstimator is referenced from Chapter 02 sample; in a real repo   -->
  <!-- this would be a shared NuGet package or ProjectReference.             -->

</Project>
