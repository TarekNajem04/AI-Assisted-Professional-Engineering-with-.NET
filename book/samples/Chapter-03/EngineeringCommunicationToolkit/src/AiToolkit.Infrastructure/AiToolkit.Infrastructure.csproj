<Project Sdk="Microsoft.NET.Sdk">
  <!-- book/samples/Chapter-03/EngineeringCommunicationToolkit/src/AiToolkit.Infrastructure/AiToolkit.Infrastructure.csproj -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../AiToolkit.Core/AiToolkit.Core.csproj" />
    <ProjectReference Include="../AiToolkit.Application/AiToolkit.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Version range: avoids restore failure if the specific patch is not published. -->
    <PackageReference Include="OpenAI" Version="[2.0.0,3.0.0)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
  </ItemGroup>

</Project>
