{
  // ExternalGateway:UseStub=true serves the deterministic in-process stub.
  // Set to false plus a real BaseUrl for the Polly-pipelined live client.
  "ExternalGateway": {
    "UseStub": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
